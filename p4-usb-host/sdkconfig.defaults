CONFIG_IDF_TARGET="esp32p4"
# CPU-REVISION VARIANT: this file is the pre_v3 baseline (v0.x/v1.x engineering
# samples — our actual silicon). The next two lines pin that family+min-rev.
# To build for v3.0/v3.1 silicon, DON'T edit here — use scripts/build.sh --rev
# v3_0|v3_1, which layers sdkconfig.rev_v3_*.defaults over this file into an
# isolated build dir. See docs/2026-07-28-p4-cpu-revision-variants.md.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
# P2 PIE-trap fix: rev-0 minimum re-enables the IDF HWLP silicon-bug
# workarounds (SOC_CPU_HAS_HWLOOP_STATE_BUG + spurious EXT_ILL reason bit,
# portasm.S) that REV_MIN=100 compiled out. With them absent, the lazy PIE
# coprocessor save mis-routed ~1-in-600 traps in dsps_fird_s16_arp4 into
# unhandled Illegal-instruction panics (31 identical crashes in 3.5 h,
# 2026-07-06). Belt-and-braces with patches/0002 (HWLP removal).
CONFIG_ESP32P4_REV_MIN_0=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# Build with -O2. Default IDF target picks "Debug" (-Og) which is awful for
# scalar DSP loops — the windowing, magnitude, and EMA loops measured 4×
# slower under -Og than the same code at -O2. Cost: a slightly larger
# binary (still well within the 1 MB app partition) and slightly worse
# stepping behaviour in gdb. Worth it.
# (IDF v6.1 only exposes Debug/Size/Performance/None as choices; no LTO
# option in Kconfig. Per-file aggressive flags are applied via the main
# CMakeLists.txt for the DSP hot files.)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set

# LOG_VERSION_2 enables dynamic suppression of ESP_DRAM_LOGE — needed
# to silence IDF's dma_utils:no-mem-for-stash-buffer spam fired ~100/min
# under DMA-INT pressure. Under v1 those errors went straight to
# esp_rom_printf which esp_log_level_set cannot reach. See
# signal_buffer.c's esp_log_level_set call.
CONFIG_LOG_VERSION_2=y
CONFIG_SPIRAM=y
# P4-NANO PSRAM is HEX (x16) mode — SPIRAM_TYPE_OCTAL was a stale/inapplicable
# symbol (removed in IDF release/v6.1, produced an "unknown kconfig symbol"
# warning). The P4 defaults to SPIRAM_MODE_HEX; set it explicitly.
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
# DMA-capable internal SRAM reserve. Bumped from 32 KB (IDF default)
# so driver-side internal allocations don't spill into PSRAM (which
# would add load on the AXI bus that DSP and worker share).
#
# History:
#  - 98304 (96 KB) covered ingest_core1's raw + conv slot demand
#    (2 × 16 KB raw + 2 × 32 KB conv = 96 KB).
#  - 118784 (116 KB) added headroom for fft_sc16_2048's twiddle +
#    dsp_processor's s_accum + uw_correlator scratch.
#  - 180224 (176 KB) was TRIED but FAILS: with CACHE_L2_CACHE_256KB
#    eating 128 KB of internal SRAM, 176 KB can't be reserved
#    ("Could not reserve internal/DMA pool 0x101" -> abort() boot
#    loop, 2026-07-19). ~144 KB is the internal ceiling.
#  - 147456 (144 KB) is the working value. To fit the USB transfer
#    pool within it (CONFIG_USB_HOST_DWC_DMA_CAP_MEMORY_IN_PSRAM=n
#    means transfer bufs MUST be internal DMA), ASYNC_TRANSFER_COUNT
#    was cut 6->4 (48->32 KB) and dsp_processor's handle (accum[])
#    moved to PSRAM (+~8 KB internal). Pre-stream free ~40 KB >= the
#    4x8 KB=32 KB pool -> transfer_alloc succeeds, rate=4.77 MB/s.
#
# ingest_core1's resample output (s_resamp) stays in PSRAM — AXI-
# GDMA reads PSRAM sources fine and the resample's CPU touch is one
# linear write per cycle.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=147456
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# Enables EXT_RAM_BSS_ATTR placement of static .bss variables into
# PSRAM. The .bss audit (docs/p4-bss-audit.md) identified ~140 KiB
# of firmware-owned static buffers (uw_correlator FFT scratch +
# precomputed tables, bch_decoder syndrome LUT) that are touched
# only on per-burst cadence and don't need DMA-internal SRAM. The
# annotations have no effect without this gate.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
# Kept at the IDF default (n). ERRATA ATTRIBUTION CORRECTION (2026-06):
# MSPI-750 (USB/SDMMC unaligned DMA reads return stale PSRAM data) is a
# v3.0-ONLY erratum — it does NOT affect our v1.x silicon. Verified
# against the ESP-Chip-Errata v1.0 tag: the only v1 errata are APM-560,
# I2C-308, RMT-176, none of which is a USB/PSRAM-DMA correctness bug.
# (MSPI-749/750/751 are introduced in v3.0 and fixed in v3.1.) So on v1
# this setting is NOT errata-mandated. We keep it off for two reasons
# that ARE valid:
#   1. Performance: USB DMA lands in internal SRAM and signal_buffer_push
#      moves it to the PSRAM ring via AXI-GDMA — the measured biggest
#      single throughput win. Letting the USB AHB master write PSRAM
#      directly adds a contender to the PSRAM-contention ceiling and is
#      less efficient than AXI-GDMA for the ring write — plausibly a
#      regression on v1, not a win.
#   2. Forward-compat trip-wire: a future hub-support / large-control-
#      transfer change that sets USB_TRANSFER_FLAG_ALLOC_DMA would
#      silently land USB-DMA buffers in PSRAM. Harmless on v1, but on a
#      v3.0 part it WOULD open MSPI-750 (unfixed until v3.1). Off is the
#      safe default across every revision we might run on.
# We never pass ALLOC_DMA today (all calls use flag = 0 → internal SRAM),
# so this is a no-op for current code either way. APM-560 (the real v1
# erratum) only fires on an APM permission *violation*, which a correctly
# authorized access never triggers (IDF's default APM config handles it),
# so it is not a reason this must be off.
CONFIG_USB_HOST_DWC_DMA_CAP_MEMORY_IN_PSRAM=n

# Bigger L2 cache. Default was 128 KB; baseline[] (8 KB) + magnitudes[] (8 KB)
# + window_cplx (8 KB) + USB ringbuffer working-set don't co-exist cleanly in
# 128 KB and were thrashing during the baseline EMA.
#
# 512 KB ate 384 KB of internal SRAM heap and broke init (convert_buf malloc
# failed silently). 256 KB only takes 128 KB of internal SRAM and is still 2x
# the default — covers the DSP hot working set without starving heap.
CONFIG_CACHE_L2_CACHE_256KB=y

# FreeRTOS runtime stats so we can see %CPU per task per core. Required to
# answer "is Core 1 actually idle / where is Core 0 spending its time".
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
# xCoreID field in TaskStatus_t for the per-task dump.
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Watchdog tuning. The class_driver task on Core 0 is intentionally hot
# (drains the USB ringbuffer continuously); IDLE0 effectively never runs.
# Stop watching either IDLE task so legitimate full-load operation isn't a
# false-positive. Worker (Core 1) processes 200+ bursts/sec under flood and
# legitimately starves IDLE1; the previous "IDLE1 stays watched as a sanity
# check" tripped TWDT panics that the USB-CDC log doesn't capture (the
# panic dump goes to the dedicated UART pins). We don't use vTaskDelete,
# idle hook, or power policy — nothing relies on idle running.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# Backtrace + coredump on real WDT events instead of silent reset.
CONFIG_ESP_TASK_WDT_PANIC=y
# Bumped from the 5 s default to give the smoke task headroom while
# we work through Phase 3.6.M perf items (notably the rotate_to_dc
# cosf/sinf cost — task #58). The smoke task subscribes to the task
# WDT for Phase 2 and blocks inside ingest_core1_take_converted's
# xSemaphoreTake(portMAX_DELAY) when ingest+worker fall behind; at
# 5 s the smoke task panics before reaching its esp_task_wdt_reset()
# call. Revert to 5 once the rotation rewrite + ingest perf land.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
# Per-task heap usage for diagnosing leaks under load. Left off for now —
# initial enable triggered an Interrupt WDT timeout on CPU1 during boot,
# probably from per-alloc critical sections piling up during the worker's
# big PSRAM allocations. Re-enable later if specifically debugging heap.
# CONFIG_HEAP_TASK_TRACKING=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---------------------------------------------------------------
# D17: esp_hosted (Wi-Fi over SDIO RPC to the C6) — sized down so
# the always-on transport doesn't starve internal SRAM / DMA-INT
# below what the DSP pipeline needs. Without these, boot asserts in
# sdio_mempool_create or pumps perf through the floor.
#
# - MEMPOOL_PREFER_SPIRAM: route transport buffers to PSRAM (P4 GDMA
#   reaches PSRAM through cache, so this is free for our throughput).
# - DFLT_TASK_FROM_SPIRAM: hosted task stacks in PSRAM (saves ~10 KB
#   internal SRAM across the 3 hosted tasks).
# - SDIO Q sizes shrunk 20 → 8: queue arrays live in internal SRAM
#   even when mempool is PSRAM; 8 is plenty for our Wi-Fi traffic.
# - MAX_SIMULTANEOUS_*_RPC_REQUESTS 5 → 2: trim RPC queue depth.
# - MEM_MONITOR off / CLI off: unused features.
# - Stacks: trimmed slightly (still in PSRAM now).
# ---------------------------------------------------------------
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=8
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=8
CONFIG_ESP_HOSTED_RPC_TASK_STACK=3072
CONFIG_ESP_HOSTED_DFLT_TASK_STACK=2560
CONFIG_ESP_HOSTED_MAX_SIMULTANEOUS_SYNC_RPC_REQUESTS=2
CONFIG_ESP_HOSTED_MAX_SIMULTANEOUS_ASYNC_RPC_REQUESTS=2
CONFIG_ESP_HOSTED_MEM_MONITOR=n
CONFIG_ESP_HOSTED_CLI_ENABLED=n

# ---------------------------------------------------------------
# Robustness (T59 crash fix, 2026-07-05)
# ---------------------------------------------------------------
# The default 1536 B/core FreeRTOS interrupt stack overflows under the
# high interrupt + cross-core IPC load the SNR priority queue drives at
# extreme detection rates (~700 bursts/s of bench RFI). Symptom was a
# "Stack protection fault" on Core 1's xIsrStack (found via UART core dump:
# no task stack overflowed — worker used 688/16384 — it was the ISR stack).
# 4096 gives ample margin for nested IRQs + SysTick + the cross-core mutex
# churn. (Deeper follow-up: reduce that IPC churn at the source.)
CONFIG_FREERTOS_ISR_STACKSIZE=4096

# UART core dump on panic (ELF format) — the tool that localized the crash
# above. Cheap (only fires on panic), invaluable for the intermittent
# load-dependent faults this pipeline can hit. Decode with:
#   esp-coredump info_corefile --core <b64> --core-format b64 build/p4-usb-host.elf
CONFIG_ESP_COREDUMP_ENABLE_TO_UART=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=64
CONFIG_ESP_COREDUMP_UART_DELAY=0

# Allow OTA from a plain-HTTP LAN server (the ota_runner uses no cert bundle;
# without this esp_https_ota_begin returns INVALID_ARG — the P4 OTA never worked).
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# Enable HTTP Content-Range parsing so ota_runner can use partial_http_download:
# the 1.4 MB image is pulled in bounded 32 KB Range requests instead of one
# sustained transfer the flaky esp_hosted C6 SDIO link stalls partway through.
CONFIG_ESP_HTTP_CLIENT_ENABLE_GET_CONTENT_RANGE=y
# Compiles in the partial_http_download / max_http_request_size fields that
# ota_runner sets (gated off by default in esp_https_ota).
CONFIG_ESP_HTTPS_OTA_ENABLE_PARTIAL_DOWNLOAD=y

# App rollback: a bad remote OTA self-heals instead of bricking. With this on,
# esp_ota_set_boot_partition() marks the new app PENDING_VERIFY; ota_runner_mark_valid()
# (called in app_main after core services are up) confirms it. If the new image
# bootloops before that call, the bootloader reverts to the previous ota_N slot on
# the next reset. Essential once the device is deployed off-USB (no port to reflash).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# esp_hosted SDIO software checksum. Default-off ("optional - SDIO HW handles it"),
# but the SD-bus CRC only protects the wire, NOT the RX heap buffers. esp_hosted
# corrupts a byte in a large sustained RX transfer (proven: OTA downloads verify-fail
# at both 2.12.9 AND 2.12.10), and with this + lwip IP/UDP checks all off, nothing
# catches it. With this on, the host drops a corrupt SDIO frame (sdio_drv.c) -> TCP
# retransmits -> reliable downloads. MUST match the C6 slave's CONFIG_ESP_SDIO_CHECKSUM.
# Cost is network-frame-only (the RTL-SDR stream is USB, not SDIO) - negligible.
CONFIG_ESP_HOSTED_SDIO_CHECKSUM=y

# SD subsystem (#63): message log (NDJSON) + on-demand raw-IQ capture/trace.
# Kept in defaults (not just local menuconfig) so a `rm sdkconfig; reconfigure`
# doesn't silently reset it to the Kconfig default (n) and lose SD persistence.
# COST: links SDMMC+FATFS -> ~50 KB internal DMA-SRAM reserved at link time,
# which competes with the USB transfer pool + fft_burst_tagger's 65 KB alloc.
# Watch tagger alloc + rate>0 after enabling (see 6bd218b rationale).
CONFIG_ENABLE_SD_LOG=y

# exFAT (patches/0008 sets FF_FS_EXFAT=1) references FF_USE_LABEL in its C
# paths, and ESP-IDF's ffconf.h does `#define FF_USE_LABEL CONFIG_FATFS_USE_LABEL`
# UNGUARDED — undefined when the option is off → "undeclared identifier" build
# error. Enable it: the volume-label API is native to exFAT anyway (tiny code).
CONFIG_FATFS_USE_LABEL=y

# Console 115200 (2026-07-23): pinned to a single baud for the WHOLE device
# lifetime — 2nd-stage bootloader, IDF console init, AND the serial_cmd
# runtime re-config (serial_cmd.c) must ALL agree at 115200, or the console
# changes baud mid-boot and a fixed-baud host reader garbles one phase.
# 115200 is the rate this Mac's CH34x driver reliably frames (921600 was
# tried and the P4 console-TX would not read cleanly on the Mac). Core-0
# UART-TX busy-spin is bounded by uart_log AUTO muting when network-up, so
# the lower baud's cost only applies while logs are explicitly on.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
