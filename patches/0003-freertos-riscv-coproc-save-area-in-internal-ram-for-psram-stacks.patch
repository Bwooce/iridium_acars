+/* Internal-RAM pool used for the coprocessor save areas when the task stack lives in
+ * external RAM. The PIE save/restore uses 128-bit vector loads/stores (esp.vst.128.ip)
+ * which must not target PSRAM. Allocated eagerly at task creation (the lazy save runs
+ * in the illegal-instruction trap where the heap must not be used), freed with the TCB.
+ * NULL when the stack is internal or the allocation failed (fall back to stack carving).
+ * -- iridium_acars patch */
+STRUCT_FIELD  (void*, 4, RV_COPROC_INT_POOL, sa_intpool)
