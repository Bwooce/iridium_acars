diff --git a/components/freertos/FreeRTOS-Kernel/portable/riscv/portasm.S b/components/freertos/FreeRTOS-Kernel/portable/riscv/portasm.S
--- a/components/freertos/FreeRTOS-Kernel/portable/riscv/portasm.S
+++ b/components/freertos/FreeRTOS-Kernel/portable/riscv/portasm.S
@@ -270,6 +270,28 @@ _hwlp_restore_end:
  * @brief Macros to save and restore the PIE coprocessor registers to and from the given frame
  */
 .macro pie_save_regs frame=a0
+    /* ==== iridium_acars patch 0006 — force strict-aligned PIE CFG for the save ====
+     * The IDF FreeRTOS-P4 port does NOT context-switch the PIE CFG register (it
+     * saves Q0-7/QACC/UA_STATE/XACC/SAR/SAR_BYTES/FFT_BIT_WIDTH but never CFG).
+     * Both our own PIE kernels (resample_arp4.S, rotate_to_dc_arp4.S) and
+     * esp-dsp's dsps_fird_s16_arp4.S set CFG bit 1 (unaligned 128-bit vld) and
+     * never clear it, so once any PIE kernel has run, the core is left in
+     * unaligned-vld mode permanently — including here, where this routine's own
+     * esp.vst.128.ip / esp.st.ua.state run against the (16-byte-aligned) save
+     * frame. Hypothesis for the Core-1 HP-WDT wedge on the Q-register run: the
+     * save/restore was validated with CFG at its reset (strict-aligned) value,
+     * and running it in unaligned mode against a stale UA_STATE stalls the
+     * pipeline. See docs/superpowers/plans/2026-07-07-pie-regression-archaeology.md.
+     * Fix: save caller CFG in t3, clear bit 1 (strict 16-byte alignment) for the
+     * duration of the register-file save, restore caller CFG at the end so
+     * application PIE code still gets unaligned mode. t3/t4 are free scratch here:
+     * the routine has already clobbered all caller-saved regs via its C calls, and
+     * the trap entry saves/restores the full GP file around this handler. The
+     * esp.movx.r/w.cfg ops + the t3..t6 encoding match resample_arp4.S:54-58,
+     * rotate_to_dc_arp4.S:37-39 and dsps_fird_s16_arp4.S:50-52. */
+    esp.movx.r.cfg  t3           /* t3 = caller PIE CFG (persists across this macro) */
+    andi            t4, t3, ~0x2 /* clear bit 1 (unaligned 128-bit vld) */
+    esp.movx.w.cfg  t4           /* run the save in strict 16-byte-aligned mode */
     /* Save the 128-bit Q registers from the frame memory and then frame += 16 */
     esp.vst.128.ip  q0, \frame, 16
     esp.vst.128.ip  q1, \frame, 16
@@ -337,10 +359,21 @@ _hwlp_restore_end:
     /* SAR register (6 bits) */
     esp.movx.r.sar a1
     sb    a1, 6(\frame)          /* Store byte after the SAR_BYTES and FFT_BIT_WIDTH */
+    /* iridium_acars patch 0006: restore caller PIE CFG (re-enables unaligned vld
+     * for application PIE code). */
+    esp.movx.w.cfg  t3
 .endm
 
 
 .macro pie_restore_regs frame=a0
+    /* iridium_acars patch 0006 — mirror of the pie_save_regs CFG bracket. The
+     * confirmed wedge PC is the 4th vld here (esp.vld.128.ip q3); force strict
+     * 16-byte-aligned mode for the register-file restore, then restore caller CFG.
+     * See the header comment on pie_save_regs and
+     * docs/superpowers/plans/2026-07-07-pie-regression-archaeology.md. */
+    esp.movx.r.cfg  t3           /* t3 = caller PIE CFG (persists across this macro) */
+    andi            t4, t3, ~0x2 /* clear bit 1 (unaligned 128-bit vld) */
+    esp.movx.w.cfg  t4           /* run the restore in strict 16-byte-aligned mode */
     /* Restore the 128-bit Q registers from the frame memory and then frame += 16 */
     esp.vld.128.ip  q0, \frame, 16
     esp.vld.128.ip  q1, \frame, 16
@@ -382,6 +415,9 @@ _hwlp_restore_end:
     /* SAR register (6 bits) */
     lbu   a1, 6(\frame)
     esp.movx.w.sar a1           /* SAR[5:0] = rs1[5:0] */
+    /* iridium_acars patch 0006: restore caller PIE CFG (re-enables unaligned vld
+     * for application PIE code). */
+    esp.movx.w.cfg  t3
 .endm
 
 generate_coprocessor_routine pie, PIE_COPROC_IDX, pie_enable, pie_save_regs, pie_restore_regs
